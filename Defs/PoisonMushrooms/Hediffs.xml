<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <HediffDef>
    <defName>RMush_PoisonFlyAgaric</defName>
    <label>fly agaric poisoning</label>
    <description>Confusion, drowsiness and impaired consciousness; severe poisoning can leave the victim unable to act. Symptoms resolve gradually after onset. Ordinary medical care can speed recovery.</description>
    <hediffClass>RimMushrooms.Hediff_MushroomPoisoning</hediffClass>
    <defaultLabelColor>(0.85, 0.65, 0.35)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>true</tendable>
    <isBad>true</isBad>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>6</baseTendDurationHours>
        <tendOverlapHours>0</tendOverlapHours>
        <severityPerDayTended>0</severityPerDayTended>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMushrooms.MushroomPoisonSettings">
        <latencyHoursMin>1</latencyHoursMin>
        <latencyHoursMax>1</latencyHoursMax>
        <recoveryDaysMin>0.5</recoveryDaysMin>
        <recoveryDaysMax>1</recoveryDaysMax>
        <untreatedSeverityPerDay>0.1</untreatedSeverityPerDay>
        <maximumSeverity>1</maximumSeverity>
        <fatal>false</fatal>
        <peakSeverity>0.48</peakSeverity>
        <responseGraceHours>24</responseGraceHours>
        <lethalSeverity>0.95</lethalSeverity>
        <stabilizationTreatment>1</stabilizationTreatment>
      </li>
    </modExtensions>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>asymptomatic</label>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>confused and drowsy</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>impaired consciousness</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe neurological poisoning</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.55</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>profound drowsiness</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.8</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RMush_PoisonDestroyingAngel</defName>
    <label>destroying angel poisoning</label>
    <description>Delayed gastrointestinal symptoms followed by progressive liver injury. Symptoms appearing to ease do not mean the poisoning has stopped. Untreated poisoning can be fatal. Care must be repeated using the normal medical system. Recovery is gradual after stabilization. After the first symptom warning, a single exposure grants at least 24 hours before this poisoning itself can enter its lethal stage. Other illnesses, injuries and additional exposures are not covered.</description>
    <hediffClass>RimMushrooms.Hediff_MushroomPoisoning</hediffClass>
    <defaultLabelColor>(0.85, 0.65, 0.35)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>true</tendable>
    <isBad>true</isBad>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>6</baseTendDurationHours>
        <tendOverlapHours>0</tendOverlapHours>
        <severityPerDayTended>0</severityPerDayTended>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMushrooms.MushroomPoisonSettings">
        <latencyHoursMin>8</latencyHoursMin>
        <latencyHoursMax>8</latencyHoursMax>
        <recoveryDaysMin>3</recoveryDaysMin>
        <recoveryDaysMax>5</recoveryDaysMax>
        <untreatedSeverityPerDay>0.22</untreatedSeverityPerDay>
        <maximumSeverity>1</maximumSeverity>
        <fatal>true</fatal>
        <peakSeverity>0.6</peakSeverity>
        <responseGraceHours>24</responseGraceHours>
        <lethalSeverity>0.95</lethalSeverity>
        <stabilizationTreatment>1</stabilizationTreatment>
      </li>
    </modExtensions>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>asymptomatic</label>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>gastrointestinal symptoms</label>
        <vomitMtbDays>0.3333333333333333</vomitMtbDays>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>quieter symptoms; liver injury continues</label>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe liver injury</label>
        <vomitMtbDays>0.3333333333333333</vomitMtbDays>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>critical liver poisoning</label>
        <vomitMtbDays>0.3333333333333333</vomitMtbDays>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.55</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.45</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
