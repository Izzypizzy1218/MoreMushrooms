<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="RMush_PoisonRawBase" ParentName="OrganicProductBase" Abstract="True">
    <stackLimit>75</stackLimit>
    <possessionCount>0</possessionCount>
    <socialPropernessMatters>true</socialPropernessMatters>
    <thingCategories>
      <li>RMush_PoisonMushrooms</li>
    </thingCategories>
    <statBases>
      <Nutrition>0</Nutrition>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <graphicData>
      <graphicClass>RimMushrooms.Graphic_MushroomStack</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <ingestible>
      <foodType>Fungus</foodType>
      <drugCategory>None</drugCategory>
      <preferability>NeverForNutrition</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
      <baseIngestTicks>500</baseIngestTicks>
      <chairSearchRadius>0</chairSearchRadius>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>RawVegetable_Eat</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
    </ingestible>
    <modExtensions>
      <li Class="RimMushrooms.MushroomStackThresholds">
        <lowMaxCount>25</lowMaxCount>
        <mediumMaxCount>50</mediumMaxCount>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="RMush_PoisonRawBase">
    <defName>RMush_RawFlyAgaric</defName>
    <label>fly agaric</label>
    <description>Poisonous fly agaric. Confusion, drowsiness and impaired consciousness; severe poisoning can leave the victim unable to act. Excluded from automatic eating and ordinary cooking. Can only be eaten by an explicit order. Treat poisoning with regular doctor care and medicine; no special antidote is required.</description>
    <graphicData>
      <texPath>Things/Item/RimMushrooms/FlyAgaric</texPath>
    </graphicData>
    <statBases>
      <MarketValue>0.8</MarketValue>
    </statBases>
    <ingestible>
      <ingestCommandString>Eat {0} (poisonous)</ingestCommandString>
      <ingestReportString>Eating {0} (poisonous).</ingestReportString>
      <outcomeDoers>
        <li Class="RimMushrooms.IngestionOutcomeDoer_MushroomPoison">
          <hediff>RMush_PoisonFlyAgaric</hediff>
          <doseUnitCount>1</doseUnitCount>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>15</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="RMush_PlantBase">
    <defName>RMush_PlantFlyAgaric</defName>
    <label>fly agaric cluster</label>
    <description>A wild cluster of poisonous fly agaric. Can be harvested but cannot be sown. Confusion, drowsiness and impaired consciousness; severe poisoning can leave the victim unable to act. The harvested mushrooms are excluded from automatic eating and ordinary cooking.</description>
    <graphicData>
      <texPath>Things/Plant/RimMushrooms/FlyAgaric</texPath>
    </graphicData>
    <statBases>
      <Nutrition>0</Nutrition>
    </statBases>
    <ingestible Inherit="False" IsNull="True" />
    <plant>
      <purpose>Misc</purpose>
      <humanFoodPlant>false</humanFoodPlant>
      <growDays>7</growDays>
      <harvestYield>8</harvestYield>
      <harvestedThingDef>RMush_RawFlyAgaric</harvestedThingDef>
      <wildBiomes>
        <TemperateForest>0.006</TemperateForest>
        <BorealForest>0.005</BorealForest>
      </wildBiomes>
    </plant>
  </ThingDef>
