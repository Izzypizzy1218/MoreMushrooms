<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="RMush_PlantBase" ParentName="PlantBase" Abstract="True">
    <thingClass>RimMushrooms.Plant_Mushroom</thingClass>
    <modExtensions>
      <li Class="RimMushrooms.MushroomLightSettings">
        <shadeMaxGlow>0.5</shadeMaxGlow>
        <fullLightGrowthFactor>0.5</fullLightGrowthFactor>
      </li>
    </modExtensions>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <pathCost>14</pathCost>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <harvestTag>Standard</harvestTag>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <diesToLight>false</diesToLight>
      <topWindExposure>0</topWindExposure>
      <visualSizeRange>0.3~0.65</visualSizeRange>
      <maxMeshCount>9</maxMeshCount>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
      <wildOrder>1</wildOrder>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>5</wildClusterWeight>
      <minGrowthTemperature>0</minGrowthTemperature>
      <minOptimalGrowthTemperature>10</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>30</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>45</maxGrowthTemperature>
      <harvestMinGrowth>0.65</harvestMinGrowth>
      <harvestAfterGrowth>0</harvestAfterGrowth>
      <lifespanDaysPerGrowDays>5</lifespanDaysPerGrowDays>
    </plant>
  </ThingDef>
  <ThingDef ParentName="RMush_PlantBase">
    <defName>RMush_PlantButton</defName>
    <label>button mushroom cluster</label>
    <description>A cluster of button mushrooms growing directly from the soil. Grows normally at light levels up to 50%. Stronger light gradually slows growth to 50% speed at 100% light, without direct light damage. Can be sown in growing zones.</description>
    <graphicData>
      <texPath>Things/Plant/RimMushrooms/Button</texPath>
    </graphicData>
    <plant>
      <growDays>6</growDays>
      <harvestYield>10</harvestYield>
      <harvestedThingDef>RMush_RawButton</harvestedThingDef>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <sowMinSkill>0</sowMinSkill>
      <wildBiomes>
        <TemperateForest>0.018</TemperateForest>
        <TemperateSwamp>0.012</TemperateSwamp>
      </wildBiomes>
    </plant>
  </ThingDef>
