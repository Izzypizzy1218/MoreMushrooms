<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="RMush_RawBase" ParentName="PlantFoodRawBase" Abstract="True">
    <stackLimit>75</stackLimit>
    <possessionCount>10</possessionCount>
    <statBases>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <graphicData>
      <graphicClass>RimMushrooms.Graphic_MushroomStack</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <ingestible>
      <foodType>Fungus</foodType>
    </ingestible>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
      </mergeCompatibilityTags>
    </ingredient>
    <modExtensions>
      <li Class="RimMushrooms.MushroomStackThresholds">
        <lowMaxCount>25</lowMaxCount>
        <mediumMaxCount>50</mediumMaxCount>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="RMush_RawBase">
    <defName>RMush_RawButton</defName>
    <label>button mushroom</label>
    <description>Edible button mushrooms. Can be cooked in ordinary meals or eaten raw. Counts as fungus.</description>
    <graphicData>
      <texPath>Things/Item/RimMushrooms/Button</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>20</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
