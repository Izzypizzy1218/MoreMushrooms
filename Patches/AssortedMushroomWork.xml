<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Only replace the vanilla workers. Other crops delegate to vanilla code. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WorkGiverDef[defName="GrowerSow"]/giverClass[text()="WorkGiver_GrowerSow"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/WorkGiverDef[defName="GrowerSow"]/giverClass</xpath>
      <value><giverClass>RimMushrooms.WorkGiver_AssortedMushroomSow</giverClass></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WorkGiverDef[defName="GrowerHarvest"]/giverClass[text()="WorkGiver_GrowerHarvest"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/WorkGiverDef[defName="GrowerHarvest"]/giverClass</xpath>
      <value><giverClass>RimMushrooms.WorkGiver_AssortedMushroomHarvest</giverClass></value>
    </match>
  </Operation>
</Patch>
